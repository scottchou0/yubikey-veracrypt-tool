<Window x:Class="WalletKeyTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WalletKeyTool" Height="820" Width="1120" MinHeight="720" MinWidth="980"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#172638" CornerRadius="14" Padding="20" Margin="0,0,0,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="WALLET KEY TOOL" FontSize="23" FontWeight="Bold"/><TextBlock Text="YubiKey · VeraCrypt · 本地钱包备份管理" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Column="1" Background="#173C3B" CornerRadius="16" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="本地运行 · 不上传数据" Foreground="#9BE2C5"/></Border>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#332C1B" BorderBrush="#80662E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
      <TextBlock Text="安全提示：本工具尚未经过独立安全审计。先用测试容器演练；不要直接导入真实助记词。Keyfile 生成后可能被 Windows 恶意软件读取。" TextWrapping="Wrap" Foreground="#F3D89A"/>
    </Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
        <StackPanel>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="01  设备状态" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="DeviceStatus" Text="尚未检测" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DeviceDetail" Text="连接 YubiKey 后点击右侧检测" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
                <Button Grid.Column="1" Content="检测设备" Click="Detect_Click" MinWidth="110"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="02  首次初始化 / 重新配置" FontSize="17" FontWeight="Bold" Margin="0,0,0,5"/>
              <TextBlock Text="先在 VeraCrypt 中挂载独立恢复容器，再把恢复密钥保存到该容器内。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
              <TextBlock Text="恢复密钥文件保存位置（例如 R:\recovery-secret.txt）" Foreground="{StaticResource MutedBrush}"/>
              <DockPanel Margin="0,5,0,8"><TextBox x:Name="RecoveryPathBox"/><Button Content="浏览…" Click="BrowseRecovery_Click" Margin="8,0,0,0"/></DockPanel>
              <Button Content="生成恢复密钥并配置 YubiKey" Click="Initialize_Click" Height="42"/>
              <Button Content="使用已有恢复密钥重新配置 YubiKey" Click="Provision_Click" Background="#36536A" Foreground="#E7EDF5"/>
              <TextBlock Text="注意：会覆盖 YubiKey OTP 短按槽的现有配置。请确认该槽可被覆盖。" Foreground="#E8B86A" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="03  日常生成 Keyfile" FontSize="17" FontWeight="Bold" Margin="0,0,0,5"/>
              <TextBlock Text="选择临时输出位置。建议使用 RAM Disk；不要把生成的 Keyfile 长期留在普通磁盘。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
              <TextBlock Text="Keyfile 输出位置" Foreground="{StaticResource MutedBrush}"/>
              <DockPanel Margin="0,5,0,8"><TextBox x:Name="KeyfilePathBox"/><Button Content="浏览…" Click="BrowseKeyfile_Click" Margin="8,0,0,0"/></DockPanel>
              <Button Content="连接 YubiKey 并生成 Keyfile" Click="Generate_Click" Height="42"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="04  灾难恢复（不需要 YubiKey）" FontSize="17" FontWeight="Bold" Margin="0,0,0,5"/>
              <TextBlock Text="挂载恢复容器后，选择其中的 recovery-secret.txt，再指定新的 Keyfile 输出位置。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
              <TextBlock Text="恢复密钥文件" Foreground="{StaticResource MutedBrush}"/>
              <DockPanel Margin="0,5,0,8"><TextBox x:Name="RestoreSecretBox"/><Button Content="浏览…" Click="BrowseRestoreSecret_Click" Margin="8,0,0,0"/></DockPanel>
              <TextBlock Text="恢复 Keyfile 输出位置" Foreground="{StaticResource MutedBrush}"/>
              <DockPanel Margin="0,5,0,8"><TextBox x:Name="RestoreKeyfileBox"/><Button Content="浏览…" Click="BrowseRestoreKeyfile_Click" Margin="8,0,0,0"/></DockPanel>
              <Button Content="从恢复材料生成 Keyfile" Click="Recover_Click" Height="42"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Column="1">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="05  恢复一致性验证" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="选择正常生成的 Keyfile 和恢复生成的 Keyfile，程序比较 SHA-256。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Text="正常 Keyfile" Foreground="{StaticResource MutedBrush}"/>
            <DockPanel Margin="0,5,0,8"><TextBox x:Name="NormalCompareBox"/><Button Content="选择" Click="BrowseNormalCompare_Click" Margin="8,0,0,0"/></DockPanel>
            <TextBlock Text="恢复 Keyfile" Foreground="{StaticResource MutedBrush}"/>
            <DockPanel Margin="0,5,0,8"><TextBox x:Name="RestoreCompareBox"/><Button Content="选择" Click="BrowseRestoreCompare_Click" Margin="8,0,0,0"/></DockPanel>
            <Button Content="比较两个 Keyfile" Click="Compare_Click" Height="40"/>
            <TextBlock x:Name="CompareResult" Text="尚未验证" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="06  VeraCrypt" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="本工具不会把容器密码放入命令行。请在 VeraCrypt 自己的界面中选择容器、输入密码并添加 Keyfile。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Text="VeraCrypt.exe 路径" Foreground="{StaticResource MutedBrush}"/>
            <DockPanel Margin="0,5,0,8"><TextBox x:Name="VeraCryptPathBox"/><Button Content="浏览…" Click="BrowseVeraCrypt_Click" Margin="8,0,0,0"/></DockPanel>
            <Button Content="打开 VeraCrypt" Click="OpenVeraCrypt_Click" Height="40"/>
          </StackPanel>
        </Border>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18">
          <StackPanel><TextBlock Text="操作日志" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/><TextBox x:Name="LogBox" Height="190" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0B111A"/></StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="3" Text="WalletKeyTool 0.1.0  |  仅在可信 Windows 环境中使用  |  重要资产请保留独立离线恢复副本" Foreground="{StaticResource MutedBrush}" Margin="2,14,0,0"/>
  </Grid>
</Window>
